# ---------------------------------------------------------------------------
# Copy this file to `.env` and replace every CHANGE_ME with a real value.
# `.env` is git-ignored. NEVER commit real secrets.
#
#   cp .env.example .env      (bash)
#   Copy-Item .env.example .env   (PowerShell)
# ---------------------------------------------------------------------------

# ---- PostgreSQL (consumed by the `db` service in docker-compose.yml) ----
POSTGRES_USER=assignment_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=assignment_system
POSTGRES_PORT=5432

# ---- Backend connection string ----
# Host is `db` inside docker-compose; use `localhost` when running the API on the host.
ConnectionStrings__Default=Host=db;Port=5432;Database=assignment_system;Username=assignment_user;Password=CHANGE_ME_strong_db_password

# ---- JWT ----
# Generate a real 32+ byte key locally and keep it out of git:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#   bash:       openssl rand -base64 48
Jwt__Key=CHANGE_ME_generate_a_random_48_byte_base64_key
Jwt__Issuer=AssignmentSystem.Api
Jwt__Audience=AssignmentSystem.Client
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# ---- CORS (comma-separated origins the API will accept) ----
CORS__AllowedOrigins=http://localhost:3000

# ---- Seeding ----
# true  -> run the idempotent seeder on API startup (demo accounts, classes, assignments)
# false -> skip seeding
SEED_ON_STARTUP=true

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ---------------------------------------------------------------------------
# Demo account passwords are NOT stored here. The seeder hashes them at first
# run; the plaintext values used for evaluation are listed in README.md.
# ---------------------------------------------------------------------------
